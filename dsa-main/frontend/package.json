{
  "name": "dsa-management",
  "version": "1.0.0",
  "description": "DSA Management ",
  "keywords": ["react", "fleet-management", "static-website", "tailwind"],
  "homepage": "https://dsamanagement.pl",
  "private": true,
  "dependencies": {
    "cra-template": "1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "build:docker": "docker build -t dsa-management .",
    "deploy:netlify": "npm run build && echo 'Upload build folder to Netlify or push to connected repo'",
    "deploy:vercel": "vercel --prod",
    "deploy:gh-pages": "npm run build && gh-pages -d build",
    "serve": "serve -s build -l 3000",
    "prebuild": "echo 'Building DSA Management website...'",
    "postbuild": "echo 'Build completed! Ready for deployment.'",
    "clean": "rm -rf build node_modules yarn.lock && yarn install",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write src/**/*.{js,jsx,css,md}"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.23.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "globals": "15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/dsa-management.git"
  },
  "author": "DSA Management",
  "license": "UNLICENSED"
}
